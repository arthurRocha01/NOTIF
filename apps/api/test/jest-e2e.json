{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "ESNext",
          "moduleResolution": "Node",
          "resolvePackageJsonExports": false,
          "esModuleInterop": true
        }
      }
    ]
  },
  "extensionsToTreatAsEsm": [
    ".ts"
  ]
}