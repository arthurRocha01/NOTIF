# ── Banco de dados (Supabase / PostgreSQL) ────────────────────────────────────
# Conexão com pooling (PgBouncer) — usada pela aplicação em runtime
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexão direta — usada pelas migrations do Prisma
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# ── Autenticação ──────────────────────────────────────────────────────────────
# Gere um segredo próprio (ex.: openssl rand -hex 32)
JWT_SECRET="troque-por-um-segredo-proprio"
JWT_EXPIRES_IN="1d"

# ── Firebase (notificações push via FCM) ──────────────────────────────────────
# Opção 1: caminho para o arquivo da service account (não versionar o arquivo)
GOOGLE_APPLICATION_CREDENTIALS="./caminho/para/service-account.json"
# Opção 2: a service account inteira como uma linha de JSON (é o formato usado em produção)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}'
